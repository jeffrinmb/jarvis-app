{
  "$defs": {
    "TaskBudget": {
      "additionalProperties": false,
      "properties": {
        "max_cost_usd": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Cost Usd"
        },
        "max_tokens": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Tokens"
        }
      },
      "title": "TaskBudget",
      "type": "object"
    },
    "TaskState": {
      "enum": [
        "created",
        "specified",
        "planned",
        "building",
        "verifying",
        "reviewing",
        "awaiting_human",
        "parked",
        "merged",
        "done",
        "failed",
        "cancelled"
      ],
      "title": "TaskState",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "baseline_revision": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Git revision recorded before any change is made",
      "title": "Baseline Revision"
    },
    "branch": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Branch"
    },
    "budget": {
      "$ref": "#/$defs/TaskBudget"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "done_by": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Human who marked the task done; agents cannot",
      "title": "Done By"
    },
    "id": {
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "owner": {
      "description": "Named human accountable for the task",
      "minLength": 1,
      "title": "Owner",
      "type": "string"
    },
    "parked_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Parked Reason"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "stage": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Stage"
    },
    "state": {
      "$ref": "#/$defs/TaskState",
      "default": "created"
    },
    "tainted": {
      "default": false,
      "title": "Tainted",
      "type": "boolean"
    },
    "title": {
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    },
    "worktree_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Worktree Path"
    }
  },
  "required": [
    "id",
    "title",
    "owner",
    "created_at",
    "updated_at"
  ],
  "title": "Task",
  "type": "object"
}
