{
  "$defs": {
    "Decision": {
      "description": "Outcome of a policy check.",
      "enum": [
        "allow",
        "council",
        "human",
        "deny"
      ],
      "title": "Decision",
      "type": "string"
    },
    "EventKind": {
      "enum": [
        "task_created",
        "task_state_changed",
        "model_call",
        "tool_call",
        "tool_denied",
        "policy_decision",
        "approval_requested",
        "approval_granted",
        "approval_denied",
        "council_vote",
        "memory_proposed",
        "memory_promoted",
        "handoff",
        "file_edit",
        "budget_warning",
        "budget_exceeded",
        "loop_detected",
        "anomaly_detected",
        "kill_switch",
        "error",
        "note"
      ],
      "title": "EventKind",
      "type": "string"
    },
    "ModelRef": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "prompt_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt Version"
        },
        "provider": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider"
        }
      },
      "required": [
        "name"
      ],
      "title": "ModelRef",
      "type": "object"
    },
    "RiskClass": {
      "description": "Ordered from least to most risky; use ``rank`` to compare.",
      "enum": [
        "read",
        "low",
        "medium",
        "high",
        "critical"
      ],
      "title": "RiskClass",
      "type": "string"
    },
    "ToolRef": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        }
      },
      "required": [
        "id"
      ],
      "title": "ToolRef",
      "type": "object"
    },
    "TrustLabel": {
      "enum": [
        "trusted",
        "internal",
        "untrusted"
      ],
      "title": "TrustLabel",
      "type": "string"
    },
    "Usage": {
      "additionalProperties": false,
      "properties": {
        "cost_usd": {
          "default": 0.0,
          "minimum": 0,
          "title": "Cost Usd",
          "type": "number"
        },
        "tokens_cached": {
          "default": 0,
          "minimum": 0,
          "title": "Tokens Cached",
          "type": "integer"
        },
        "tokens_in": {
          "default": 0,
          "minimum": 0,
          "title": "Tokens In",
          "type": "integer"
        },
        "tokens_out": {
          "default": 0,
          "minimum": 0,
          "title": "Tokens Out",
          "type": "integer"
        }
      },
      "title": "Usage",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "One thing that happened. Free-form detail goes in ``data`` and must be redacted\nbefore it is written (no secrets or PII).",
  "properties": {
    "agent_id": {
      "minLength": 1,
      "title": "Agent Id",
      "type": "string"
    },
    "approver": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Approver"
    },
    "data": {
      "additionalProperties": true,
      "title": "Data",
      "type": "object"
    },
    "decision": {
      "anyOf": [
        {
          "$ref": "#/$defs/Decision"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "event_id": {
      "pattern": "^[0-9a-f]{32}$",
      "title": "Event Id",
      "type": "string"
    },
    "kind": {
      "$ref": "#/$defs/EventKind"
    },
    "model": {
      "anyOf": [
        {
          "$ref": "#/$defs/ModelRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "on_behalf_of": {
      "minLength": 1,
      "title": "On Behalf Of",
      "type": "string"
    },
    "outcome": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Outcome"
    },
    "risk": {
      "anyOf": [
        {
          "$ref": "#/$defs/RiskClass"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "span_id": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{16}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Span Id"
    },
    "stage": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Stage"
    },
    "tainted": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Tainted"
    },
    "task_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Task Id"
    },
    "tool": {
      "anyOf": [
        {
          "$ref": "#/$defs/ToolRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "trace_id": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{32}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Trace Id"
    },
    "trust": {
      "anyOf": [
        {
          "$ref": "#/$defs/TrustLabel"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "ts": {
      "format": "date-time",
      "title": "Ts",
      "type": "string"
    },
    "usage": {
      "anyOf": [
        {
          "$ref": "#/$defs/Usage"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "kind",
    "agent_id",
    "on_behalf_of"
  ],
  "title": "Event",
  "type": "object"
}
